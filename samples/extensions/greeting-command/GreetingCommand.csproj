<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>GreetingCommand</AssemblyName>
    <RootNamespace>Premagentic.Samples.Commands</RootNamespace>
  </PropertyGroup>

  <!-- The contracts come from the process that loads this; see the
       sentence-chunker sample for why Private="false". -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Premagentic.Core\Premagentic.Core.csproj" Private="false" />
  </ItemGroup>

  <!-- A command and a setting are seams like any other, so the manifest
       declares both: an older PremAgentic then refuses this by name. -->
  <Target Name="WriteExtensionManifest" AfterTargets="Build">
    <GetFileHash Files="$(TargetPath)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="HashedAssembly" />
    </GetFileHash>
    <PropertyGroup>
      <AssemblyHash>@(HashedAssembly->'%(FileHash)')</AssemblyHash>
      <ManifestText>{
  "name": "greeting-command",
  "version": "$(Version)",
  "assemblyFile": "$(TargetFileName)",
  "sha256": "$(AssemblyHash)",
  "seams": { "command": 1, "setting": 1 }
}</ManifestText>
    </PropertyGroup>
    <WriteLinesToFile File="$(TargetDir)extension.json" Lines="$(ManifestText)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
