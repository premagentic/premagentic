<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <!-- Testcontainers 4.13.0 pulls SSH.NET 2025.1.0, which carries two high
         severity advisories (GHSA-mggc-4xg6-vcxf, GHSA-q939-rpr3-3284), both
         patched in 2026.0.0. The direct reference lifts the transitive
         version. Remove it once Testcontainers ships with a patched SSH.NET. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- One test runs the real CLI in a child process. It must run from the CLI's
       own build output, not from this folder: this project carries the ASP.NET
       Core shared framework, so its build leaves out assemblies that framework
       provides, and the CLI, which runs on the base runtime alone, ships some
       of those beside itself. Which ones depends on the installed SDK, so the
       gap shows on one machine and not another. The path is recorded here at
       build time, where it is known for certain. -->
  <Target Name="RecordCliPath" BeforeTargets="GetAssemblyAttributes">
    <MSBuild Projects="..\..\src\Premagentic.Cli\Premagentic.Cli.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="PremagenticCliPath" />
    </MSBuild>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>Premagentic.Cli.Path</_Parameter1>
        <_Parameter2>$(PremagenticCliPath)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!-- The sample extension is built before this project and is NOT referenced:
       referencing it would load it into this process the ordinary way, and the
       point of the test is that the host loads it from a folder, by hash, into
       its own context. Its path is recorded here for the same reason the CLI's
       is: at build time it is known for certain. -->
  <Target Name="RecordSampleExtensionPath" BeforeTargets="GetAssemblyAttributes">
    <MSBuild Projects="..\..\samples\extensions\sentence-chunker\SentenceChunker.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="SentenceChunkerPath" />
    </MSBuild>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>Premagentic.Sample.SentenceChunker.Path</_Parameter1>
        <_Parameter2>$(SentenceChunkerPath)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!-- The same, for the sample extension that ships a library of its own. -->
  <Target Name="RecordParagraphExtensionPath" BeforeTargets="GetAssemblyAttributes">
    <MSBuild Projects="..\..\samples\extensions\paragraph-chunker\ParagraphChunker.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="ParagraphChunkerPath" />
    </MSBuild>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>Premagentic.Sample.ParagraphChunker.Path</_Parameter1>
        <_Parameter2>$(ParagraphChunkerPath)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!-- The same, for the sample extension that sends reminders by mail. -->
  <Target Name="RecordMailExtensionPath" BeforeTargets="GetAssemblyAttributes">
    <MSBuild Projects="..\..\samples\extensions\mail-reminders\MailReminders.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="MailRemindersPath" />
    </MSBuild>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>Premagentic.Sample.MailReminders.Path</_Parameter1>
        <_Parameter2>$(MailRemindersPath)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!-- The same, for the test extension that registers a principal mapper and
       nothing else. -->
  <Target Name="RecordInertMapperExtensionPath" BeforeTargets="GetAssemblyAttributes">
    <MSBuild Projects="..\extensions\inert-mapper\InertMapper.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="InertMapperPath" />
    </MSBuild>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>Premagentic.Test.InertMapper.Path</_Parameter1>
        <_Parameter2>$(InertMapperPath)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!-- The same, for the sample extension that adds commands and a setting. -->
  <Target Name="RecordGreetingExtensionPath" BeforeTargets="GetAssemblyAttributes">
    <MSBuild Projects="..\..\samples\extensions\greeting-command\GreetingCommand.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="GreetingCommandPath" />
    </MSBuild>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>Premagentic.Sample.GreetingCommand.Path</_Parameter1>
        <_Parameter2>$(GreetingCommandPath)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!-- The same, for the sample extension that ships a native library. -->
  <Target Name="RecordNativeExtensionPath" BeforeTargets="GetAssemblyAttributes">
    <MSBuild Projects="..\..\samples\extensions\native-lines\NativeLines.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="NativeLinesPath" />
    </MSBuild>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>Premagentic.Sample.NativeLines.Path</_Parameter1>
        <_Parameter2>$(NativeLinesPath)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!-- The first-party readers, built first and NOT referenced, for the same
       reason as the samples: a process that already holds a reader's library
       hands it to the host, and the tests must see the host load the one in
       the reader's own folder. A reference that does not reference the output
       brings none of a reader's packages either, which
       FirstPartyReaderTests checks. Their fixtures are shared with the
       readers' own tests. -->
  <Target Name="RecordFirstPartyReaderPaths" BeforeTargets="GetAssemblyAttributes">
    <MSBuild Projects="..\..\extensions\pdf-reader\PdfReader.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="PdfReaderPath" />
    </MSBuild>
    <MSBuild Projects="..\..\extensions\docx-reader\DocxReader.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="DocxReaderPath" />
    </MSBuild>
    <MSBuild Projects="..\..\extensions\xlsx-reader\XlsxReader.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="XlsxReaderPath" />
    </MSBuild>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>Premagentic.Extension.PdfReader.Path</_Parameter1>
        <_Parameter2>$(PdfReaderPath)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>Premagentic.Extension.DocxReader.Path</_Parameter1>
        <_Parameter2>$(DocxReaderPath)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>Premagentic.Extension.XlsxReader.Path</_Parameter1>
        <_Parameter2>$(XlsxReaderPath)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Compile Include="..\Premagentic.Readers.Tests\PdfFixtures.cs" Link="Fixtures\PdfFixtures.cs" />
    <Compile Include="..\Premagentic.Readers.Tests\DocxFixtures.cs" Link="Fixtures\DocxFixtures.cs" />
    <Compile Include="..\Premagentic.Readers.Tests\XlsxFixtures.cs" Link="Fixtures\XlsxFixtures.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Premagentic.Core\Premagentic.Core.csproj" />
    <ProjectReference Include="..\..\src\Premagentic.Cli\Premagentic.Cli.csproj" />
    <ProjectReference Include="..\..\src\Premagentic.Api\Premagentic.Api.csproj" />
    <ProjectReference Include="..\..\src\Premagentic.McpServer\Premagentic.McpServer.csproj" />
    <ProjectReference Include="..\Premagentic.Conformance\Premagentic.Conformance.csproj" />
    <ProjectReference Include="..\..\samples\extensions\sentence-chunker\SentenceChunker.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\samples\extensions\paragraph-chunker\ParagraphChunker.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\samples\extensions\native-lines\NativeLines.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\samples\extensions\mail-reminders\MailReminders.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\samples\extensions\greeting-command\GreetingCommand.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\extensions\inert-mapper\InertMapper.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\extensions\pdf-reader\PdfReader.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\extensions\docx-reader\DocxReader.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\extensions\xlsx-reader\XlsxReader.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

</Project>
