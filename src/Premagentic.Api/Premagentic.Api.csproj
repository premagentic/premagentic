<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Premagentic.Core\Premagentic.Core.csproj" />
    <ProjectReference Include="..\Premagentic.Portal\Premagentic.Portal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Premagentic.Tests" />
  </ItemGroup>

  <!-- Each activates only under its own service manager, so one build runs as a
       console process, a Windows service or a systemd unit. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
  </ItemGroup>

  <!-- A published build carries its own ICU, one version on Windows and Linux.
       Password hashing normalizes Unicode and chunking compares text, so both must
       behave the same on every server, and a Linux without libicu must still run.
       Invariant globalization was measured and rejected: it does not normalize.
       Only for a Windows or Linux runtime identifier: the package has no macOS
       build, and a development build without one uses the system's ICU instead of
       carrying all five platforms' copies. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' != '' and !$(RuntimeIdentifier.StartsWith('osx'))">
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
